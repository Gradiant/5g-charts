{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "startupProbe": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "initialDelaySeconds": {
                    "type": "integer",
                    "minimum": 0
                },
                "periodSeconds": {
                    "type": "integer",
                    "minimum": 1
                },
                "timeoutSeconds": {
                    "type": "integer",
                    "minimum": 1
                },
                "failureThreshold": {
                    "type": "integer",
                    "minimum": 1
                },
                "successThreshold": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1
                }
            }
        },
        "customStartupProbe": {
            "type": "object"
        },
        "readinessProbe": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "initialDelaySeconds": {
                    "type": "integer",
                    "minimum": 0
                },
                "periodSeconds": {
                    "type": "integer",
                    "minimum": 1
                },
                "timeoutSeconds": {
                    "type": "integer",
                    "minimum": 1
                },
                "failureThreshold": {
                    "type": "integer",
                    "minimum": 1
                },
                "successThreshold": {
                    "type": "integer",
                    "minimum": 1
                }
            }
        },
        "customReadinessProbe": {
            "type": "object"
        },
        "livenessProbe": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "initialDelaySeconds": {
                    "type": "integer",
                    "minimum": 0
                },
                "periodSeconds": {
                    "type": "integer",
                    "minimum": 1
                },
                "timeoutSeconds": {
                    "type": "integer",
                    "minimum": 1
                },
                "failureThreshold": {
                    "type": "integer",
                    "minimum": 1
                },
                "successThreshold": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1
                }
            }
        },
        "customLivenessProbe": {
            "type": "object"
        }
    }
}
